<resources>
    <style name="Theme.FamilyCall" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorControlActivated">@color/brand</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.FamilyCall.Call" parent="Theme.FamilyCall">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <style name="TextAppearance.FamilyCall.Title" parent="@android:style/TextAppearance.Material.Headline">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.FamilyCall.Section" parent="@android:style/TextAppearance.Material.Subhead">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.FamilyCall.PrimaryButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.FamilyCall.SecondaryButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/brand</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
