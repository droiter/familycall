<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/callRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true"
    android:keepScreenOn="true">

    <FrameLayout
        android:id="@+id/remoteContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true"
        android:clipToPadding="true">

        <TextureView
            android:id="@+id/remoteVideo"
            android:layout_width="640dp"
            android:layout_height="480dp"
            android:layout_gravity="center"
            android:visibility="invisible" />
    </FrameLayout>

    <View
        android:id="@+id/topFade"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_top_fade" />

    <View
        android:id="@+id/bottomFade"
        android:layout_width="match_parent"
        android:layout_height="290dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_fade" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="42dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/peerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/callStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#C8D4E6"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/statsButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_control_glass"
            android:contentDescription="@string/stats"
            android:padding="11dp"
            android:src="@drawable/ic_stats" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/localPreviewContainer"
        android:layout_width="104dp"
        android:layout_height="146dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="112dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_preview"
        android:clipChildren="true"
        android:clipToOutline="true"
        android:elevation="8dp">

        <TextureView
            android:id="@+id/localVideo"
            android:layout_width="104dp"
            android:layout_height="146dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/statusOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_status_overlay"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:indeterminateTint="@color/white" />

        <TextView
            android:id="@+id/statusOverlayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/connecting"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/childCancelButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_control_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="132dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="取消呼叫"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/statsPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="120dp"
        android:background="@drawable/bg_stats"
        android:fontFamily="monospace"
        android:lineSpacingExtra="3dp"
        android:padding="14dp"
        android:textColor="#E6FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/muteButton"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_control_glass"
                android:contentDescription="@string/mute"
                android:padding="17dp"
                android:src="@drawable/ic_mic" />

            <TextView
                android:id="@+id/muteLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/mute"
                android:textColor="#D7E0ED"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/speakerButton"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_control_glass"
                android:contentDescription="@string/speaker"
                android:padding="17dp"
                android:src="@drawable/ic_volume" />

            <TextView
                android:id="@+id/speakerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/speaker"
                android:textColor="#D7E0ED"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/switchButton"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_control_glass"
                android:contentDescription="@string/switch_camera"
                android:padding="17dp"
                android:src="@drawable/ic_camera_switch" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/switch_camera"
                android:textColor="#D7E0ED"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/hangupButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circle_red"
                android:contentDescription="@string/hangup"
                android:padding="19dp"
                android:src="@drawable/ic_call_end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/hangup"
                android:textColor="#FFC9CC"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/endingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_ending"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/endingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/call_ended"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/endingDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#B9C6D9"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
